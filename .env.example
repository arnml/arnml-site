# DATABASE URL
# You can get your own free Neon database at https://neon.tech
# Replace the placeholder values with your actual database credentials
DATABASE_URL="postgresql://neondb_owner:npg_..."

# NIGHTCRAWL PRIVATE AREA
# Keep both values secret. Use different values in production.
NIGHTCRAWL_PASSWORD="YOUR_NIGHTCRAWL_PASSWORD_HERE"
NIGHTCRAWL_SESSION_SECRET="A_LONG_RANDOM_SESSION_SECRET_HERE"

# ENVIRONMENT
# For development use "development", for production use "production"
NODE_ENV="development"

# EMAIL API (reserved for the upcoming contact form)
RESEND_API_KEY="re_...."
RESEND_FROM_EMAIL="Arnold Moya <contact@arnoldmoya.com>"

# SITE CONFIGURATION
# Public site URL for SEO metadata, OpenGraph tags, and canonical URLs
NEXT_PUBLIC_SITE_URL="https://arnoldmoya.com"
